{
  "name": "@fradser/open-deskos-linux-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Open DeskOS shell for the Orange Pi CM5 (RK3588S) Linux panel, 1920x1280 HDMI display",
  "main": "src/main.js",
  "scripts": {
    "styles": "unocss \"src/renderer/**/*.html\" \"src/renderer/**/*.js\" -c uno.config.mjs -o src/renderer/uno.css --minify",
    "styles:watch": "unocss \"src/renderer/**/*.html\" \"src/renderer/**/*.js\" -c uno.config.mjs -o src/renderer/uno.css --watch",
    "start": "unocss \"src/renderer/**/*.html\" \"src/renderer/**/*.js\" -c uno.config.mjs -o src/renderer/uno.css --minify && electron .",
    "smoke": "unocss \"src/renderer/**/*.html\" \"src/renderer/**/*.js\" -c uno.config.mjs -o src/renderer/uno.css --minify && electron . --smoke",
    "e2e": "unocss \"src/renderer/**/*.html\" \"src/renderer/**/*.js\" -c uno.config.mjs -o src/renderer/uno.css --minify && electron tests/e2e.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@tabler/icons": "^3.46.0",
    "@unocss/cli": "^66.8.1",
    "electron": "^43.4.1",
    "unocss": "^66.8.1"
  }
}
