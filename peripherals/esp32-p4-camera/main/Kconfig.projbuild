menu "ESP32-P4 SC2336 Camera Configuration"

    config APP_CAMERA_MIPI_SCCB_SDA_PIN
        int "SCCB SDA GPIO Pin"
        default 7

    config APP_CAMERA_MIPI_SCCB_SCL_PIN
        int "SCCB SCL GPIO Pin"
        default 8

    config APP_CAMERA_SC2336_MIPI_RESET_PIN
        int "SC2336 Reset GPIO Pin"
        default 26

    config APP_CAMERA_SC2336_MIPI_PWDN_PIN
        int "SC2336 Power Down GPIO Pin (-1 if unused)"
        default -1

    config APP_CAMERA_SCCB_I2C_PORT
        int "SCCB I2C Port"
        default 0

    config APP_CAMERA_SCCB_I2C_FREQ
        int "SCCB I2C Frequency in Hz"
        default 100000

    config APP_CAMERA_FRAME_WIDTH
        int "UVC Frame Width"
        default 1280

    config APP_CAMERA_FRAME_HEIGHT
        int "UVC Frame Height"
        default 720

    config APP_UVC_JPEG_QUALITY
        int "MJPEG compression quality (1-100)"
        range 1 100
        default 80

    config APP_USB_MICROPHONE
        bool "Expose the board microphone as a USB Audio Class input"
        default y

    config APP_AUDIO_I2S_PORT
        int "ES8311 I2S port"
        default 0
        depends on APP_USB_MICROPHONE

    config APP_AUDIO_I2S_MCLK_PIN
        int "ES8311 I2S MCLK GPIO"
        default 13
        depends on APP_USB_MICROPHONE

    config APP_AUDIO_I2S_BCLK_PIN
        int "ES8311 I2S BCLK GPIO"
        default 12
        depends on APP_USB_MICROPHONE

    config APP_AUDIO_I2S_WS_PIN
        int "ES8311 I2S WS/LRCLK GPIO"
        default 10
        depends on APP_USB_MICROPHONE

    config APP_AUDIO_I2S_DIN_PIN
        int "ES8311 ASDOUT to P4 I2S DIN GPIO"
        default 11
        depends on APP_USB_MICROPHONE

    config APP_AUDIO_INPUT_GAIN_DB
        int "ES8311 microphone input gain in dB"
        range 0 42
        default 30
        depends on APP_USB_MICROPHONE

endmenu
