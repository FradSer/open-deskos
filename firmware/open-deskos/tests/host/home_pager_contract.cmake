function(require_pattern source label pattern)
    string(FIND "${source}" "${pattern}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "${label}: missing '${pattern}'")
    endif()
endfunction()

function(forbid_pattern source label pattern)
    string(FIND "${source}" "${pattern}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "${label}: must not contain '${pattern}'")
    endif()
endfunction()

# LVGL's built-in SCROLL_ONE flag limits a snap gesture to the adjacent
# snappable child. A short, fast flick may use release momentum to select that
# adjacent target. At the P4's observed bitmap-frame cadence (~30 ms), the
# home pager needs 180 ms to expose at least six positions in its non-zero
# settle animation. LVGL can cancel it at its current coordinate when the next
# drag starts, so a reverse gesture continues naturally instead of jumping to
# an endpoint.
require_pattern("${pager}" "home pager one-page policy" "scroll_one = true")
require_pattern("${pager}" "home pager adjacent snap alignment" "snap_x = \"center\"")
require_pattern("${pager}" "home pager supports short fast flicks" "momentum = true")
require_pattern("${pager}" "home pager has six-sample settle duration" "local PAGER_SNAP_SETTLE_MS = 180")
require_pattern("${pager}" "home pager has continuous release snap" "snap_anim_ms = PAGER_SNAP_SETTLE_MS")
forbid_pattern("${pager}" "home pager must not jump at release" "snap_anim_ms = 0")

require_pattern("${indev}" "pager flick has bounded prediction" "lv_indev_set_scroll_throw(indev, 15)")
require_pattern("${core_widgets}" "decorative arcs forward horizontal pager drags" "lv_obj_add_flag(obj, LV_OBJ_FLAG_SCROLL_CHAIN_HOR);")

# Lua must expose SCROLL_ONE rather than encoding the policy in a page-count
# specific workaround, so future snap pagers receive the same LVGL guarantee.
require_pattern("${layout}" "scroll-one option parsed" "\"scroll_one\"")
require_pattern("${layout}" "scroll-one flag enabled" "LV_OBJ_FLAG_SCROLL_ONE")
require_pattern("${layout}" "snap animation option parsed" "\"snap_anim_ms\"")
require_pattern("${layout}" "snap animation duration applied" "lv_anim_set_duration(anim, record->scroll_snap_anim_ms)")
require_pattern("${layout}" "zero-duration snap selects step path" "if (record->scroll_snap_anim_ms == 0)")
