require_pattern("${indev}" "transient I2C error grace" "LUA_LVGL_TOUCH_ERROR_GRACE_SAMPLES")
require_pattern("${indev}" "transient no-contact grace" "LUA_LVGL_TOUCH_NO_CONTACT_GRACE_SAMPLES 3")

# MIPI production uses esp_lvgl_adapter's worker rather than lua_lvgl_task.
# The sampler must therefore bridge pending samples through a small LVGL timer
# owned by that worker; otherwise the hand-rolled task's input wake path and
# pager trace never run on the shipped display route.
require_pattern("${private}" "adapter touch bridge state" "touch_bridge_timer")
require_pattern("${indev}" "adapter touch bridge callback" "lua_lvgl_indev_adapter_bridge_timer_cb")
require_pattern("${indev}" "adapter touch bridge created" "lv_timer_create(lua_lvgl_indev_adapter_bridge_timer_cb")
require_pattern("${indev}" "adapter touch bridge arms native input timer" "lua_lvgl_indev_process_pending_locked();")
require_pattern("${indev}" "adapter touch bridge drains pager trace" "lua_lvgl_indev_trace_drain_locked();")
require_pattern("${indev}" "adapter touch bridge teardown" "lv_timer_delete(s_lvgl.touch_bridge_timer)")
require_pattern("${indev}" "adapter touch bridge is adapter scoped" "if (s_lvgl.adapter_active)")

# The adapter owns the production handler, so the native DPI completion probe
# cannot see its partial-strip presents. Measure the LVGL phases directly with
# display events instead: the callback is timestamp-only and runs in the same
# adapter worker that owns the refresh.
require_pattern("${private}" "display event trace hook declaration" "lua_lvgl_indev_trace_display_event_locked")
require_pattern("${runtime}" "display event trace callback" "lua_lvgl_pager_trace_display_event_cb")
require_pattern("${runtime}" "display event trace registered" "lv_display_add_event_cb(display, lua_lvgl_pager_trace_display_event_cb, LV_EVENT_ALL, NULL);")
require_pattern("${runtime}" "display trace forwards layout completion" "case LV_EVENT_UPDATE_LAYOUT_COMPLETED:")
require_pattern("${indev}" "trace records refresh work" "LV_EVENT_REFR_START")
require_pattern("${indev}" "trace records render work" "LV_EVENT_RENDER_START")
require_pattern("${indev}" "trace records refresh-frame pacing" "max-frame-gap")
require_pattern("${indev}" "trace retains the prior refresh boundary" "last_refresh_started_ms")
require_pattern("${indev}" "trace records first-motion response" "move->scroll")
require_pattern("${indev}" "trace records flush call work" "LV_EVENT_FLUSH_START")
require_pattern("${indev}" "trace records flush wait work" "LV_EVENT_FLUSH_WAIT_START")
require_pattern("${indev}" "trace reports longest refresh" "max-refresh")
require_pattern("${indev}" "trace records layout completion" "LV_EVENT_UPDATE_LAYOUT_COMPLETED")
require_pattern("${indev}" "trace reports longest layout" "max-layout")
require_pattern("${indev}" "trace reports post-layout refresh preparation" "max-post-layout")
require_pattern("${indev}" "trace reports longest render" "max-render")
require_pattern("${indev}" "trace reports longest flush" "max-flush")
require_pattern("${indev}" "trace reports longest flush wait" "max-wait")

# A snapshot drag invalidates almost the full pager viewport on every frame.
# With three existing RGB565 panel buffers, the adapter's TRIPLE_FULL route is
# the documented large-area mode: LVGL renders directly into a non-visible
# full frame rather than splitting each bitmap move into partial draw stripes.
require_pattern("${display_bringup}" "triple full has three panel framebuffers" "dpi_cfg.num_fbs = 3")
require_pattern("${runtime}" "adapter triple full selected" "ESP_LV_ADAPTER_TEAR_AVOID_MODE_TRIPLE_FULL")
require_pattern("${runtime}" "adapter display registered" "esp_lv_adapter_register_display")
forbid_pattern("${voice_ui}" "launcher must not force direct two-buffer rendering" "render=\\\"direct\\\"")

# A DPI framebuffer switch is asynchronous: waiting on VSYNC inside the LVGL
# task makes every presented frame also an input-processing stall. The panel
# refresh callback is the safe ownership boundary for lv_display_flush_ready.
require_pattern("${runtime}" "direct flush completion is asynchronous" "Direct FB swaps are asynchronous")
require_pattern("${runtime}" "refresh callback releases direct framebuffer" "lv_display_flush_ready(display);")
require_pattern("${runtime}" "idle DPI scans leave LVGL flush state untouched" "state && state->flush_pending")
forbid_pattern("${runtime}" "direct flush must not block on VSYNC" "fb-swap flush wait timeout")

# ESP32-P4's MIPI pager repeatedly moves PSRAM-backed RGB565 frame data. Keep
# the durable defaults aligned with Espressif's P4 cache/XIP recommendations
# and ensure this is a performance, rather than debug, firmware build.
require_pattern("${sdkconfig_defaults}" "P4 pager compiler profile" "CONFIG_COMPILER_OPTIMIZATION_PERF=y")
require_pattern("${sdkconfig_defaults}" "P4 pager PSRAM XIP" "CONFIG_SPIRAM_XIP_FROM_PSRAM=y")
require_pattern("${sdkconfig_defaults}" "P4 pager L2 capacity" "CONFIG_CACHE_L2_CACHE_256KB=y")
require_pattern("${sdkconfig_defaults}" "P4 pager L2 line width" "CONFIG_CACHE_L2_CACHE_LINE_128B=y")
require_pattern("${sdkconfig_defaults}" "P4 pager draw-buffer alignment" "CONFIG_LV_DRAW_BUF_ALIGN=128")
require_pattern("${sdkconfig_defaults}" "P4 pager PPA image compositor" "CONFIG_LV_USE_PPA_IMG=y")
require_pattern("${board_sdkconfig_defaults}" "P4 board draw-buffer alignment" "CONFIG_LV_DRAW_BUF_ALIGN=128")

# The LVGL task must use an absolute cadence. A relative vTaskDelay adds a
# second 2 ms wait after any long draw/flush pass, directly increasing the
# time before the next GT911 sample can reach the pager.
require_pattern("${runtime}" "LVGL task uses a fixed wake cadence" "vTaskDelayUntil(&next_wake")
forbid_pattern("${runtime}" "LVGL task must not add a post-render delay" "vTaskDelay(pdMS_TO_TICKS(state->task_period_ms")
