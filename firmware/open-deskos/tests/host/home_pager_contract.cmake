require_pattern("${voice_ui}" "script task is pinned" "xTaskCreatePinnedToCore(voice_ui_task")

# Render and input read on the same LVGL task. A quick physical drag can begin
# and end while rendering is busy, so the driver must capture GT911 samples
# independently. The reader deliberately consumes one semantic sample per indev
# timer pass: draining a historical gesture with `continue_reading` makes the
# page jump through stale coordinates before the next rendered frame.
require_pattern("${indev}" "independent GT911 sampler task" "lua_lvgl_touch_sampler_task")
