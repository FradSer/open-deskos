forbid_pattern("${layout}" "zero snap duration must override LVGL default" "record->scroll_snap_anim_ms == 0 ||")
require_pattern("${layout}" "scrollbar-free pager removes unused theme scroll state" "lv_obj_remove_theme(obj, LV_PART_SCROLLBAR | LV_STATE_SCROLLED)")

