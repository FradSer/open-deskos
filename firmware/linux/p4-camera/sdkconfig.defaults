# ESP32-P4 target
CONFIG_IDF_TARGET="esp32p4"

# Chip Revision (ESP32-P4 v1.3 compatibility)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP32P4_REV_MIN_FULL=100
CONFIG_ESP_REV_MIN_FULL=100

# Flash and PSRAM configuration
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_PARTITION=y
CONFIG_HUMAN_FACE_FEAT_MODEL_IN_FLASH_PARTITION=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Camera Interface - MIPI CSI-2 with SC2336
CONFIG_APP_CAMERA_INTERFACE_MIPI_CSI=y
CONFIG_APP_CAMERA_SENSOR_SELECTION_SC2336=y
CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_SC2336_AUTO_DETECT=y
CONFIG_CAMERA_SC2336_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC2336_MIPI_RAW8_1280x720_30FPS=y

# Default Frame Configuration
CONFIG_APP_CAMERA_FRAME_WIDTH=640
CONFIG_APP_CAMERA_FRAME_HEIGHT=480
CONFIG_APP_CAMERA_BUFFER_COUNT=3
CONFIG_APP_CAMERA_OWNER_CONFIRM_PIN=0
CONFIG_APP_CAMERA_OWNER_CONFIRM_WINDOW_SECONDS=30
CONFIG_APP_CAMERA_OWNER_NAME="Frad"
CONFIG_APP_CAMERA_PIXEL_FORMAT_RGB565=y

# SCCB I2C Pin Configuration for SC2336 on P4
CONFIG_APP_CAMERA_SCCB_I2C_PORT=0
CONFIG_APP_CAMERA_SCCB_I2C_FREQ=100000
CONFIG_APP_CAMERA_MIPI_SCCB_SCL_PIN=8
CONFIG_APP_CAMERA_MIPI_SCCB_SDA_PIN=7
CONFIG_APP_CAMERA_SC2336_MIPI_RESET_PIN=26
CONFIG_APP_CAMERA_SC2336_MIPI_PWDN_PIN=-1

# USB Device Configuration (TinyUSB for CM5 link)
CONFIG_TINYUSB=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512

# Log Level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
