[Unit]
Description=Open DeskOS Remote Bridge
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/env node __OPEN_DESKOS_REMOTE_BRIDGE_DIR__/bin/open-deskos-remote-bridge.js
Restart=always
RestartSec=2
KillSignal=SIGINT
RestartForceExitStatus=SIGHUP

[Install]
WantedBy=default.target
