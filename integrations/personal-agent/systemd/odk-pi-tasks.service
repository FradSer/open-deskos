[Unit]
Description=Open DeskOS managed Pi coding tasks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ODK_PERSONAL_AGENT_DIR__
Environment=ODK_TASK_CONFIG=%h/.config/odk/pi-tasks.json
Environment=PATH=__ODK_NODE_BIN__:/usr/local/bin:/usr/bin:/bin
ExecStart=__ODK_NODE_BIN__/node __ODK_PERSONAL_AGENT_DIR__/src/task-daemon.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ReadOnlyPaths=/opt/odk

[Install]
WantedBy=default.target
