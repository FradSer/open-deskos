[Unit]
Description=Open DeskOS resident Personal Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ODK_PERSONAL_AGENT_DIR__
Environment=ODK_TASK_CONFIG=%h/.config/odk/pi-tasks.json
# Legacy configuration is read first during upgrades; canonical settings win.
EnvironmentFile=-%h/.config/odk/voice-agent.env
EnvironmentFile=-%h/.config/odk/perosnal-agent.env
EnvironmentFile=-%h/.config/odk/runtime.env
Environment=PATH=__ODK_NODE_BIN__:/usr/local/bin:/usr/bin:/bin
ExecStart=__ODK_NODE_BIN__/node __ODK_PERSONAL_AGENT_DIR__/src/main.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
ReadOnlyPaths=/opt/odk

[Install]
WantedBy=default.target
