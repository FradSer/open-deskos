[Unit]
Description=Open DeskOS resident personal bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ODK_PERSONAL_BOT_DIR__
# Legacy configuration is read first during upgrades; canonical settings win.
EnvironmentFile=-%h/.config/odk/voice-agent.env
EnvironmentFile=-%h/.config/odk/personal-bot.env
EnvironmentFile=-%h/.config/odk/runtime.env
Environment=PATH=__ODK_NODE_BIN__:/usr/local/bin:/usr/bin:/bin
ExecStart=__ODK_NODE_BIN__/node __ODK_PERSONAL_BOT_DIR__/src/main.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
ReadOnlyPaths=/opt/odk

[Install]
WantedBy=default.target
