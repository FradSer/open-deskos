{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": false,
    "skipLibCheck": true,
    "module": "nodenext",
    "target": "es2023",
    "types": ["node"]
  },
  "include": ["src/**/*.mjs"]
}
