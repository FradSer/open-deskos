          "liveWhen": {
            "field": "plants.0.online",
            "value": true
          }
        }
      ]
    },
    {
      "id": "weather-planning",
      "goal": "有实际天气变化需要留意时给出有依据的建议。不要假设我即将出门、会下雨或存在未观测的天气风险。",
      "delivery": "immediate",
      "urgent": false,
      "observations": [
        {
          "readingId": "odk.tile.weather",
          "fields": [
            "temperatureC",
            "condition",
            "highC",
            "lowC"
          ]
        }
      ]
    }
