[Unit]
Description=Open DeskOS managed Pi coding tasks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__OPEN_DESKOS_VOICE_AGENT_DIR__
Environment=ODESK_TASK_CONFIG=%h/.config/open-deskos/pi-tasks.json
Environment=PATH=__OPEN_DESKOS_NODE_BIN__:/usr/local/bin:/usr/bin:/bin
ExecStart=__OPEN_DESKOS_NODE_BIN__/node __OPEN_DESKOS_VOICE_AGENT_DIR__/src/task-daemon.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ReadOnlyPaths=/opt/open-deskos

[Install]
WantedBy=default.target
