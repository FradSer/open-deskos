[Unit]
Description=Open DeskOS Face Agent
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=FACE_AGENT_DEVICE=/dev/open-deskos-p4-camera
ExecStart=/opt/face-agent-venv/bin/python3 /opt/face-agent/face_service.py
Restart=always
RestartSec=3
KillSignal=SIGINT

[Install]
WantedBy=default.target
